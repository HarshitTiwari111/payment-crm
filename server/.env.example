# ============================================================
#  Server
# ============================================================
PORT=4000
NODE_ENV=development
# Where the React dev server runs (needed so cookies work cross-origin in dev)
CLIENT_ORIGIN=http://localhost:5173

# Set ONLY when the app really sits behind a proxy (Nginx, Cloudflare, a platform
# load balancer). It makes Express trust X-Forwarded-For, which is what the rate
# limiter and the login log read. Trusting it with no proxy in front lets anyone
# spoof their address and slip past the limiter.
#   1     = one proxy hop (the usual)
#   true  = trust the whole chain
# TRUST_PROXY=1

# ============================================================
#  MongoDB
# ============================================================
# Local:  mongodb://127.0.0.1:27017/payment-crm
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/payment-crm?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/payment-crm

# ============================================================
#  Auth — REQUIRED in production
# ============================================================
# Two different secrets on purpose: a leaked access token must not be usable as a
# refresh token. Generate each with:  openssl rand -hex 48
# Leave blank in development and one is created into server/.jwtsecret.
JWT_SECRET=
REFRESH_SECRET=

# Access tokens are short-lived; the client refreshes silently.
ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# Brute-force protection: lock an account after this many wrong passwords.
MAX_LOGIN_ATTEMPTS=8
LOCKOUT_MINUTES=15

# ============================================================
#  Rate limiting (requests per window, per signed-in user — per IP when signed out)
# ============================================================
RATE_WINDOW_MINUTES=15
RATE_MAX_GENERAL=1000
RATE_MAX_AUTH=20
RATE_MAX_WRITE=300

# ============================================================
#  Two-factor
# ============================================================
TOTP_ISSUER=Payment CRM
# Turn on to REQUIRE it: an admin without 2FA can still sign in, but every route
# except the enrolment ones answers 403 until they finish setting it up. The first
# admin on a fresh install is not locked out — they are sent straight to enrolment.
REQUIRE_2FA_FOR_ADMIN=false

# ============================================================
#  First admin (created only when no admin exists)
# ============================================================
ADMIN_USER=admin
ADMIN_PASS=changeme123

# ============================================================
#  Telegram (optional) — audit lines and security alerts go here
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================
#  Business config
# ============================================================
BUDGET_CAP_PERCENT=100
# How often (minutes) to scan for overdue payouts. 0 disables the scanner.
OVERDUE_SCAN_MINUTES=360
